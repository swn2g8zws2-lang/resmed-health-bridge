# Copy to .env for local use. Never commit .env or real values.
RESMED_DB_PATH=/data/resmed.sqlite3
RESMED_MCP_TRANSPORT=stdio
RESMED_MCP_HOST=127.0.0.1
RESMED_MCP_PORT=8000

# Used only by the explicit resmed-import-myair command. Keep real values in a
# secret manager or the process environment, never in this file or source control.
MYAIR_USERNAME=your-myair-username
MYAIR_PASSWORD=your-myair-password
# Optional, short-lived email code when Okta requires MFA. Remove it immediately after use.
MYAIR_MFA_CODE=your-current-mfa-code

# Environment files and common secret material (only the deliberate template is safe).
.env*
**/.env*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
secret*.txt
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# SQLite databases, backups, journals, WAL and shared-memory sidecars.
*.sqlite*
*.sqlite3-*
*.db*
*.db-*
*.backup
*.bak

# CPAP/ResMed/OSCAR exports and raw device data are sensitive health data.
*.csv
*.edf
*.EDF
